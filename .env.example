# FITVEDA - Environment Variables

# OpenAI (Required: AI coach feedback + end-of-session report)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (Required: gym/dance mode detection + live vision scoring)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Optional: spoken voice for the coach, bulbul:v3. Without it the coach is text-only)
SARVAM_API_KEY=your_sarvam_api_key_here

# YouTube bot-check bypass on server IPs (Optional but usually REQUIRED on a VPS). Use one or both.
# Base64 of a Netscape cookies.txt exported from a logged-in YouTube session:
# YTDLP_COOKIES_B64=
# Proxy URL (residential proxies work best):
# YTDLP_PROXY=http://user:pass@host:port

# Custom directory for downloaded videos (Optional: defaults to the OS temp folder + /fitveda)
# VIDEO_DIR=C:\custom_video_path

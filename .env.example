# FITVEDA - Environment Variables Configuration

# OpenAI API Key (Required for AI Coach feedback and TTS audio responses)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional: Fast LLM pose scoring and coaching feedback)
GROQ_API_KEY=your_groq_api_key_here

# xAI API Key (Optional: Grok video mode classification)
XAI_API_KEY=your_xai_api_key_here

# Bright Data API Key (Optional: Web proxy fallback for YouTube downloads)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Replicate API Token (Optional: SAM2 background segmentation model)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Zoom Web SDK Credentials (Optional: Zoom integration app)
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# Sarvam AI API Key (Required for AI voice coach TTS — bulbul:v3 model)
SARVAM_API_KEY=your_sarvam_api_key_here

# Custom Temporary Video Directory (Optional: Override default OS temp folder)
# VIDEO_DIR=C:\custom_video_path

